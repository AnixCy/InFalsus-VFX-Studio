<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><CheckEolTargetFramework>false</CheckEolTargetFramework>
    <InteropDir Condition="'$(InteropDir)' == ''">$(GameReferenceRoot)\MelonLoader\Il2CppAssemblies</InteropDir>
    <LoaderDir Condition="'$(LoaderDir)' == ''">$(GameReferenceRoot)\MelonLoader\net6</LoaderDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="profiles.json" LogicalName="InFalsus.Presentation.Profiles.json" />
    <ProjectReference Include="..\Presentation\portable\InFalsus.Presentation.Portable.csproj" />
    <ProjectReference Include="..\Addon\InFalsus.Vfx.Addon.csproj" />
    <Reference Include="$(LoaderDir)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(LoaderDir)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(InteropDir)\Il2Cppmscorlib.dll" Private="false" Aliases="Il2CppBase" />
    <!-- Generated Unity nullable attributes use IL2CPP arrays; hide them from Roslyn's well-known-type lookup. -->
    <Reference Include="$(InteropDir)\UnityEngine.CoreModule.dll" Private="false" Aliases="UnityCore" />
    <Reference Include="$(InteropDir)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(InteropDir)/UnityEngine.CoreModule.dll')" Text="Set GameReferenceRoot to a reviewed game copy with matching MelonLoader IL2CPP interop references." />
  </Target>
</Project>
