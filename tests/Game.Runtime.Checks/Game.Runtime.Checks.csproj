<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><AssemblyName>InFalsus.Vfx.GameChecks</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>latest</LangVersion>
    <CheckEolTargetFramework>false</CheckEolTargetFramework><TreatWarningsAsErrors>true</TreatWarningsAsErrors><UseSharedCompilation>false</UseSharedCompilation><NuGetAudit>false</NuGetAudit>
    <InteropDir>$(GameReferenceRoot)/MelonLoader/Il2CppAssemblies</InteropDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/GameRuntime/InFalsus.Presentation.Game.csproj" />
    <Reference Include="$(GameReferenceRoot)/MelonLoader/net6/MelonLoader.dll" Private="false" />
    <Reference Include="$(GameReferenceRoot)/MelonLoader/net6/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.CoreModule.dll" Private="false" Aliases="UnityCore" />
    <Reference Include="$(InteropDir)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/Il2Cppmscorlib.dll" Private="false" Aliases="Il2CppBase" />
  </ItemGroup>
</Project>
